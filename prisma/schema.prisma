// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "./generated/"
  engineType      = "client" 
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum AccountType {
  CASH
  BANK
  E_WALLET
  CREDIT_CARD
  INVESTMENT
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum DebtType {
  LEND    // Kita pinjemin uang ke orang (piutang)
  BORROW  // Kita utang dari orang
}

// ============================================
// MODELS
// ============================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  encryptionKey String?  // Optional, untuk encrypt sensitive data
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  tags                  Tag[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  debts                 Debt[]

  @@map("users")
}

model Account {
  id       String      @id @default(cuid())
  userId   String
  name     String
  type     AccountType
  balance  Decimal     @default(0) @db.Decimal(15, 2)
  currency String      @default("IDR")
  icon     String?
  color    String?
  isActive Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  type      CategoryType
  icon      String?
  color     String?
  isDefault Boolean      @default(false) // Flag untuk kategori bawaan

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
  @@index([userId, type])
  @@map("categories")
}

model Tag {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name]) // Tag names unique per user
  @@index([userId])
  @@map("tags")
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  accountId   String
  categoryId  String?
  amount      Decimal         @db.Decimal(15, 2)
  type        TransactionType
  description String
  note        String?         // Bisa di-encrypt
  date        DateTime
  isEncrypted Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     Tag[]     // Many-to-many with tags

  @@index([userId])
  @@index([userId, date])
  @@index([userId, accountId])
  @@index([userId, categoryId])
  @@map("transactions")
}

// ============================================
// OPTIONAL FEATURES
// ============================================

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  amount     Decimal  @db.Decimal(15, 2)
  month      Int      // 1-12
  year       Int
  isActive   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year]) // One budget per category per month
  @@index([userId])
  @@index([userId, month, year])
  @@map("budgets")
}

model RecurringTransaction {
  id          String              @id @default(cuid())
  userId      String
  accountId   String
  categoryId  String?
  amount      Decimal             @db.Decimal(15, 2)
  type        TransactionType
  description String
  frequency   RecurrenceFrequency
  startDate   DateTime
  endDate     DateTime?           // Null = no end date
  nextDueDate DateTime
  isActive    Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isActive, nextDueDate])
  @@map("recurring_transactions")
}

model Debt {
  id              String    @id @default(cuid())
  userId          String
  type            DebtType  // LEND = piutang, BORROW = utang
  personName      String    // Nama orang yang utang/kita utangin
  amount          Decimal   @db.Decimal(15, 2) // Nominal awal
  remainingAmount Decimal   @db.Decimal(15, 2) // Sisa yang belum dibayar
  description     String?   // Keterangan (buat apa)
  dueDate         DateTime? // Jatuh tempo (optional)
  isPaid          Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isPaid])
  @@index([userId, type])
  @@map("debts")
}
